{
  "version": 2,
  "builds": [
    {
      "src": "gim_connect/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "maxDuration": 25,
        "includeFiles": [
          "staticfiles/**",
          "templates/**",
          "favicon.ico",
          "robots.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "gim_connect/wsgi.py"
    }
  ]
}

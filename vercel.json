{
  "version": 2,
  "buildCommand": "chmod +x build.sh && ./build.sh",
  "builds": [
    {
      "src": "gim_connect/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "gim_connect/**",
          "connect/**",
          "templates/**",
          "staticfiles/**",
          "manage.py"
        ]
      }
    }
  ],
  "functions": {
    "gim_connect/wsgi.py": {
      "maxDuration": 25
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "gim_connect/wsgi.py"
    }
  ]
}
